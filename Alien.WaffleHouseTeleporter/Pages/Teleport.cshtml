@page
@model Alien.WaffleHouseTeleporter.Pages.TeleportModel
@{ ViewData["Title"] = "Destination locked"; }
<section class="container portal-container py-5">
    <div class="teleporter-panel">
        <div class="eyebrow">DESTINATION LOCKED</div>
        <h1>@Model.SelectedLocation.Name</h1>
        <p class="lead">@Model.SelectedLocation.Address</p>
        <div class="d-flex flex-wrap gap-3 my-4">
            <a href="@Model.StreetViewUrl" class="btn btn-success btn-lg" target="_blank" rel="noopener noreferrer">Enter Street View ↗</a>
            <a href="@Model.MapsUrl" class="btn btn-outline-light" target="_blank" rel="noopener noreferrer">Find this Waffle House ↗</a>
            <a asp-page="/Teleport" asp-route-exclude="@Model.SelectedLocation.Id" class="btn btn-outline-light">Teleport again</a>
            <a asp-page="/Index" class="btn btn-outline-light">Home</a>
        </div>
        @if (Model.EmbedUrl is not null)
        {
            <div class="ratio ratio-16x9 teleporter-frame">
                <iframe src="@Model.EmbedUrl" title="Street View near the selected Waffle House" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        }
        <p class="small mt-4 mb-0">Street View may show the nearby road rather than the front door. Missing imagery? Try the map or another jump. Community location data may be incomplete or outdated.</p>
    </div>
</section>
